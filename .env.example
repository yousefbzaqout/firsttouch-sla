########################################################################
# FirstTouch SLA — environment template (SAFE PLACEHOLDERS ONLY)
# Copy to `.env` and fill secrets locally. Never commit real credentials.
########################################################################

APP_NAME="FirstTouch SLA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=firsttouch_sla
DB_USERNAME=sail
DB_PASSWORD=password
# DB_SSLMODE=prefer

# -----------------------------
# Session / cache / queue
# -----------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# -----------------------------
# Redis
# -----------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_URL=
# REDIS_USERNAME=

# -----------------------------
# Broadcasting (Reverb / Pusher-compatible)
# -----------------------------
BROADCAST_CONNECTION=log

REVERB_APP_ID=firsttouch
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
FILAMENT_ECHO_BROADCASTER=reverb

# Optional Pusher (if BROADCAST_CONNECTION=pusher)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -----------------------------
# Mail (Sail defaults to Mailpit)
# -----------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------
# Object storage (optional)
# -----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sail host user mapping (horizon / scheduler sidecars)
WWWUSER=1000
WWWGROUP=1000

# -----------------------------
# AI providers
# Embeddings prefer OPENAI_API_KEY, then fall back to OPENROUTER_API_KEY
# -----------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=

# -----------------------------
# Inbound webhook platform secrets (HMAC / shared keys)
# Leave empty in local demos only if you rely on tenant-level secrets.
# Production: set platform fallbacks OR per-tenant secrets (fail-closed).
# -----------------------------
WEBHOOKS_META_SECRET=
WEBHOOKS_TIKTOK_SECRET=
WEBHOOKS_GOOGLE_SECRET=
WEBHOOKS_SNAPCHAT_SECRET=
WEBHOOKS_UNIVERSAL_SECRET=
WEBHOOKS_WEBSITE_SECRET=

# -----------------------------
# n8n notification workflow (optional)
# -----------------------------
FORWARD_N8N_PORT=5678
N8N_PUBLIC_URL=http://localhost:5678
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook/firsttouch-sla-alerts
N8N_API_KEY=

# -----------------------------
# Telegram (platform fallback bot)
# -----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOW_CREDITS_THRESHOLD=10
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_GATEWAY_URL=

# -----------------------------
# Payments
# Use `mock` for local demos. Never commit live Stripe keys.
# -----------------------------
PAYMENT_DRIVER=mock
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# -----------------------------
# Horizon
# -----------------------------
HORIZON_PATH=horizon
# HORIZON_NAME=
# HORIZON_DOMAIN=

# -----------------------------
# Sanctum (developer API)
# -----------------------------
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,127.0.0.1
# SANCTUM_TOKEN_PREFIX=
